#!/bin/bash
# Git-native pre-commit hook: enforce the CLAUDE.md changelog rule for ALL
# commits (including those made outside Claude). Mirrors the Claude PreToolUse
# hook. Bypass intentionally with `git commit --no-verify`.
set -euo pipefail

# Allow merge commits (no manual changelog expected).
gitdir="$(git rev-parse --git-dir)"
[ -f "$gitdir/MERGE_HEAD" ] && exit 0

staged="$(git diff --cached --name-only)"
[ -z "$staged" ] && exit 0  # nothing staged → let git handle it

if printf '%s\n' "$staged" | grep -qx 'CLAUDE.md'; then
  exit 0
fi

echo "pre-commit: CLAUDE.md is not staged. Update its Changelog (see the rule at the top of CLAUDE.md) and 'git add CLAUDE.md' — or bypass with 'git commit --no-verify'." >&2
exit 1
